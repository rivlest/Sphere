{
  "name": "sphere",
  "version": "1.2.1",
  "description": "Sphere (SPH) — a local Proof-of-Work UTXO Layer 1 blockchain",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/cli/node.ts",
    "wallet": "tsx src/cli/wallet-cli.ts",
    "migrate-chain": "tsx src/cli/migrate-chain.ts",
    "bench:pow": "tsx scripts/bench-pow.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.md\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "keywords": [
    "blockchain",
    "proof-of-work",
    "sphere"
  ],
  "license": "MIT",
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/bootstrap": "^12.0.30",
    "@libp2p/circuit-relay-v2": "^4.2.12",
    "@libp2p/crypto": "^5.1.23",
    "@libp2p/dcutr": "^3.0.27",
    "@libp2p/identify": "^4.1.13",
    "@libp2p/kad-dht": "^16.4.4",
    "@libp2p/mdns": "^12.0.30",
    "@libp2p/peer-id": "^6.0.15",
    "@libp2p/ping": "^3.1.12",
    "@libp2p/tcp": "^11.0.27",
    "@libp2p/websockets": "^10.1.20",
    "@multiformats/multiaddr": "^13.0.3",
    "@noble/hashes": "^1.8.0",
    "@noble/secp256k1": "^2.2.3",
    "argon2": "^0.45.1",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "libp2p": "^3.3.9",
    "multiformats": "^14.0.5",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
