# Optional defaults. CLI flags always take precedence.
SPHERE_HTTP_PORT=3001
SPHERE_P2P_PORT=6001
SPHERE_DATA_DIR=data
SPHERE_MINER_ADDRESS=
# Optional comma-separated extra peers (merged with the compiled seed list)
SPHERE_PEERS=
# Optional test faucet. Never commit a real key. Empty = disabled.
SPHERE_FAUCET_PRIVATE_KEY=
SPHERE_FAUCET_MAX_ORBS=100000000
# Live SPH/USD JSON feed. Leave empty until SPH is listed — the node will not invent a price.
# Canonical: { "price": 0.05, "history": [{ "timestamp": 1710000000000, "price": 0.05 }] }
# CoinGecko simple/price is also accepted: { "sphere": { "usd": 0.05 } }
SPHERE_PRICE_URL=

# CoinMarketCap (GET /market). Only SPH is accepted — never SPHR (slug "sphere").
# Official Pro API: https://coinmarketcap.com/api/
CMC_API_KEY=
# Optional numeric CMC id. If empty, Pro API is queried by symbol=SPH.
CMC_ID=
# Public data-api fallback (no key). Set only to the CMC slug of SPH, not "sphere".
CMC_SLUG=
